# Sum and Average of Tuple Elements

n = int(input("Enter number of elements: "))
t = ()
for i in range(n):
    t = t + (int(input("Enter element: ")),)
total = sum(t)
avg = total / n
print("Sum:", total)
print("Average:", avg)

