# Customize Plot

import matplotlib.pyplot as plt 
x = [1, 2, 3, 4, 5] 
y1 = [10, 20, 30, 40, 50] 
y2 = [8, 16, 24, 32, 40] 
plt.plot(x, y1, marker='o', color='blue', label='Series 1') 
plt.plot(x, y2, marker='s', color='red', label='Series 2') 
plt.title("Customized Plot") 
plt.xlabel("X-axis") 
plt.ylabel("Y-axis") 
plt.legend() 
plt.grid(True) 
plt.show()

# Read File and Plot

import matplotlib.pyplot as plt
x = []
y = []
with open("Experiment No. 10/sample.txt", "r") as file:
    for line in file:
        a, b = line.split()
        x.append(int(a))
        y.append(int(b))
print(x)
print(y)
plt.plot(x, y, marker='o')
plt.title("Graph from File Data")
plt.xlabel("X-axis")
plt.ylabel("Y-axis")
plt.grid(True)
plt.show()
