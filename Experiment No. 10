# GUI Calculator

import tkinter as tk 
def press(num): 
    current = entry.get() 
    entry.delete(0, tk.END) 
    entry.insert(0, current + str(num))  
def clear(): 
    entry.delete(0, tk.END) 
def calculate(): 
    try: 
        result = eval(entry.get()) 
        entry.delete(0, tk.END) 
        entry.insert(0, str(result)) 
    except: 
        entry.delete(0, tk.END) 
        entry.insert(0, "Error") 
root = tk.Tk() 
root.title("Calculator") 
root.geometry("300x350") 
entry = tk.Entry(root, width=20, font=("Arial", 18), bd=5, justify="right") 
entry.grid(row=0, column=0, columnspan=4, pady=10) 
buttons = [ 
    '7', '8', '9', '/', 
    '4', '5', '6', '*', 
    '1', '2', '3', '-', 
    '0', 'C', '=', '+' 
] 
row = 1 
col = 0 
for button in buttons: 
    if button == 'C': 
        cmd = clear 
    elif button == '=': 
        cmd = calculate 
    else: 
        cmd = lambda b=button: press(b) 
    tk.Button(root, text=button, width=5, height=2, font=("Arial", 14), 
command=cmd).grid(row=row, column=col, padx=5, pady=5) 
    col += 1 
    if col > 3: 
        col = 0 
        row += 1 
root.mainloop()

# Student Form GUI

import tkinter as tk
from tkinter import messagebox
def submit():
    info = f"Name: {name_entry.get()}\nRoll No: {roll_entry.get()}\nCourse: {course_entry.get()}"
    messagebox.showinfo("Student Information", info)
root = tk.Tk()
root.title("Student Information Form")
root.geometry("350x250")
tk.Label(root, text="Name").grid(row=0, column=0, padx=10, pady=10)
name_entry = tk.Entry(root)
name_entry.grid(row=0, column=1)
tk.Label(root, text="Roll No").grid(row=1, column=0, padx=10, pady=10)
roll_entry = tk.Entry(root)
roll_entry.grid(row=1, column=1)
tk.Label(root, text="Course").grid(row=2, column=0, padx=10, pady=10)
course_entry = tk.Entry(root)
course_entry.grid(row=2, column=1)
tk.Button(root, text="Submit", command=submit).grid(row=3, column=1, pady=20)
root.mainloop()

