# Prime Number Using Function

def prime(n):
    if n <= 1:
        return False
    for i in range(2, n):
        if n % i == 0:
            return False
    return True
n = int(input("Enter number: "))

if prime(n):
    print("Prime")
else:
    print("Not Prime")
