# Factorial Using Function

def fact(n):
    f = 1
    for i in range(1, n+1):
        f *= i
    return f
n = int(input("Enter number: "))
print("Factorial:", fact(n))

# Factorial Using Recursion

def fact(n):
    if n == 0 or n == 1:
        return 1
    return n * fact(n-1)
n = int(input("Enter number: "))
print("Factorial:", fact(n))

# Fibonacci Using Recursion

def fib(n):
    if n <= 1:
        return n
    return fib(n-1) + fib(n-2)
n = int(input("Enter terms: "))
for i in range(n):
    print(fib(i), end=" ")

